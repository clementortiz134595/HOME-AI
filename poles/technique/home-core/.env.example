# Do not put real credentials in this file. Copy it to .env locally if needed.
# Generate an Apple app-specific password at account.apple.com.
# Keep the JSON on one line. The account ID is a local, non-secret label.
APPLE_CALDAV_ACCOUNTS_JSON=[]
HOME_CORE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
HOME_CORE_TWELVE_DATA_BASE_URL=https://api.twelvedata.com
HOME_CORE_TWELVE_DATA_API_KEY=
HOME_CORE_AI_API_KEY=
HOME_CORE_AI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
HOME_CORE_STT_BASE_URL=https://speech.googleapis.com/v2/projects
HOME_CORE_STT_API_KEY=
HOME_CORE_STT_PROJECT=
HOME_CORE_STT_LOCATION=eu
HOME_CORE_STT_LANGUAGE=fr-FR
HOME_CORE_WAKE_MODEL_DIR=/app/models/sherpa-kws
HOME_CORE_GMAIL_CLIENT_ID=
HOME_CORE_GMAIL_CLIENT_SECRET=
HOME_CORE_GMAIL_REDIRECT_URL=http://localhost:8080/v1/workspace/google/gmail/oauth/callback
HOME_CORE_GMAIL_TOKEN_PATH=/var/lib/home-core/gmail-token.json
