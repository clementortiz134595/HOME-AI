[Unit]
Description=HOME AI Home App Compose service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=HOME_APP_CERTS_DIR=/home/clement/.config/home-ai/home-app-certs
WorkingDirectory=/home/clement/deployments/home-ai/poles/technique/home-app
ExecStart=/usr/bin/docker compose -f compose.production.yaml up -d
ExecStop=/usr/bin/docker compose -f compose.production.yaml stop
TimeoutStartSec=0

[Install]
WantedBy=default.target
